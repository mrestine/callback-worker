# callback-worker
#
#   cp .env.example .env

# --- Ollama ---------------------------------------------------------------
# CLI harness on the host:            http://localhost:11434
# worker container (Docker Desktop):  http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# generous headroom for the extraction JSON
NUM_PREDICT=512

# seconds between poll cycles
POLL_INTERVAL_SECONDS=90

# --- callback API ------------------------------------------------------
CALLBACK_API_URL=https://give-me-callback.vercel.app
# a cbk_ token minted in the callback webapp (Settings -> Worker API tokens)
CALLBACK_TOKEN=

# --- Gmail -----------------------------------------------------------
# OAuth *desktop-app* client secrets JSON downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=/app/secrets/gmail-credentials.json
# written by `npm run gmail:auth` (run once, on a machine with a browser).
GMAIL_TOKEN_PATH=/app/secrets/gmail-token.json
# label state machine: <prefix>inbox -> <prefix>processing -> <prefix>processed | <prefix>error
GMAIL_LABEL_PREFIX=callback/
# the poll query — everything outstanding (labels are the state, no cursor)
GMAIL_QUERY=label:callback/inbox -label:callback/processing -label:callback/processed -label:callback/error

# --- digest reply (§8) ---------------------------------------------
# after each submission, reply in the forwarded email's thread with a summary
NOTIFY_REPLY=true
# also reply for noise / duplicates (default: stay quiet on those)
NOTIFY_ON_DISMISS=false

# --- dead-man's switch (optional) --------------------------------
# pinged after every successful poll cycle; if it goes quiet, the check
# service alerts you out-of-band (works even if Gmail auth is what broke).
HEALTHCHECK_URL=

# --- known agencies (optional) ---------------------------------
# KNOWN_AGENCY_DOMAINS=brightlinesearch.com,roberthalf.com,teksystems.com,insightglobal.com
# KNOWN_AGENCY_NAMES=Brightline Search,Robert Half,TEKsystems,Insight Global

# --- dev ---------------------------------------------------------
# extract + print, don't submit / relabel / reply
DRY_RUN=false
