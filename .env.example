# callback-worker — Stage 1 (tuning harness) only needs Ollama.
#
#   cp .env.example .env

# --- Ollama ---------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# generous headroom for the extraction JSON; tune down once a model is chosen
NUM_PREDICT=512

# --- callback API (Stage 4, not used yet) -------------------------------
# CALLBACK_API_URL=https://give-me-callback.vercel.app
# CALLBACK_TOKEN=

# --- Gmail (Stage 3, not used yet) ------------------------------------
# GMAIL_CREDENTIALS_PATH=./secrets/gmail-credentials.json
# GMAIL_TOKEN_PATH=./secrets/gmail-token.json
# GMAIL_QUERY=label:callback/inbox -label:callback/processed

# --- worker state (Stage 3, not used yet) --------------------------
# WORKER_DB_PATH=./data/worker.sqlite

# --- known agencies (Stage 4, not used yet) -----------------------
# KNOWN_AGENCY_DOMAINS=brightlinesearch.com,roberthalf.com,teksystems.com,insightglobal.com
# KNOWN_AGENCY_NAMES=Brightline Search,Robert Half,TEKsystems,Insight Global
