{
  "name": "callback-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Email ingestion worker for callback — poll, clean, extract with a local model, submit.",
  "scripts": {
    "preprocess": "tsx src/cli/preprocess.ts",
    "extract": "tsx src/cli/extract.ts",
    "pipe": "tsx src/cli/pipe.ts",
    "batch": "tsx src/cli/batch.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mailparser": "^3.7.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
